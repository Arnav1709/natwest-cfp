# StockSense Frontend — environment variables
#
# Local dev / Docker (nginx): leave this UNSET. The app uses a relative
# "/api" path that the Vite dev proxy (or nginx) forwards to the backend.
#
# Split cloud deploy (frontend on Vercel, backend on Render): set this to
# your backend's API base URL, including the /api suffix.
#   VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=
