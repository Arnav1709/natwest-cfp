# ═══════════════════════════════════════════════════════════════
# StockSense Docker Environment — COPY THIS TO backend/.env
# ═══════════════════════════════════════════════════════════════

# Database
# Local dev: SQLite. Production: a Postgres URL, e.g.
#   postgresql://user:pass@host:5432/dbname
# ("postgres://" URLs from Render/Supabase are auto-normalized.)
DATABASE_URL=sqlite:///./data/stocksense.db

# JWT Auth — MUST set a long random value in production
SECRET_KEY=change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — comma-separated frontend origins allowed in production
# e.g. CORS_ORIGINS=https://stocksense.vercel.app
CORS_ORIGINS=
# Optional regex for dynamic preview deploys, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Ollama — Local AI (primary provider)
# Install: https://ollama.com  |  Run: ollama run gemma4:latest
# Uses host.docker.internal so Docker containers can reach your local Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT=120

# Google Gemini API — fallback #1 (free tier — https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter — fallback #2 (free tier — https://openrouter.ai/)
OPENROUTER_API_KEY=your-openrouter-key-here

# Serper Web Search — intelligence layer (https://serper.dev/)
SERPER_API_KEY=your-serper-api-key-here

# App Settings
APP_NAME=StockSense
APP_VERSION=1.0.0
# Set DEBUG=false in production (disables SQL echo / verbose logging)
DEBUG=true
